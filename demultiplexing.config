# BFQ reads this separately from libprep.config: conversion never selects analysis.
schema_version: 1
bcl_convert_versions: ['4.2.4']
profiles:
  tenx-gex-v3:
    assay: gex
    minimum_biological_cycles: [28, 25]
    index_lengths: [8, 10]
    default_backend: bcl-convert
    legacy_tool: cellranger-mkfastq
    kits:
      - '10X Genomics Chromium Single Cell 3p GEM Library & Gel Bead Kit v3'
  tenx-multiome-gex:
    assay: multiome-gex
    minimum_biological_cycles: [28, 50]
    index_lengths: [10]
    require_dual_index: true
    default_backend: bcl-convert
    legacy_tool: cellranger-mkfastq
    kits:
      - '10X Genomics Chromium Single Cell Multiome Gene Expression'
  tenx-gex-v2-legacy:
    assay: legacy
    default_backend: mkfastq
    legacy_tool: cellranger-mkfastq
    kits:
      - '10X Genomics Chromium Single Cell 3p GEM Library & Gel Bead Kit v2'
  tenx-gex-v1-legacy:
    assay: legacy
    default_backend: mkfastq
    legacy_tool: cellranger-mkfastq
    kits:
      - '10X Genomics Chromium Single Cell 3p GEM Library & Gel Bead Kit v1'
  tenx-atac-legacy:
    assay: legacy
    default_backend: mkfastq
    legacy_tool: cellranger-atac-mkfastq
    kits:
      - '10X Genomics Chromium Next GEM Single Cell ATAC Library & Gel Bead Kit v1.1'
  tenx-visium-legacy:
    assay: legacy
    default_backend: mkfastq
    legacy_tool: spaceranger-mkfastq
    kits:
      - '10X Genomics Visium Spatial Gene Expression Slide & Reagents Kit'
