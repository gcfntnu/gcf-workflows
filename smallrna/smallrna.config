workflow: 'smallrna'
quant:
  method: unitas
  mirge3:
    db: mirbase
    # miRge3 --uniq-mol-ids, e.g. '4,4' for 4N randomized ends; set per kit
    uniq_mol_ids: null
  mirflowz:
    # Memory budget (GB) of mirflowz's nested runs; its jobs declare up to 60 GB (full-genome segemehl index)
    mem_gb: 60

align:
  genome:
    aligner: star
  star:
    args: '--outSAMtype BAM SortedByCoordinate --genomeLoad LoadAndKeep --outMultimapperOrder Random --outSAMstrandField intronMotif --outSAMunmapped Within --outSAMattrIHstart 0 --outFilterMismatchNoverLmax 0.05 --outFilterMatchNmin 15 --outFilterScoreMinOverLread 0  --outFilterMatchNminOverLread 0 --alignIntronMax 1 --limitBAMsortRAM 20000000000 --outFilterMultimapNmax 10 --outFilterMultimapScoreRange 0 --alignEndsType EndToEnd '
    guided_index: false

filter:
  trim:
    mirtrace:
      protocol: null
  spikein:
    filter: false
    quantifier: skip
    # Comma-separated spike-in sets, e.g. 'ERCC92,smallrna_calibrators'; null for none
    ref: null
  ribosomal:
    filter: false
    quantifier: skip
    ref: ncbi
  contaminants:
    filter: false
    quantifier: skip
    ref: univec_core
