workflow: 'smallrna'
quant:
  method: unitas
  mirge3:
    db: mirbase
  mirflowz:
    # Memory budget (GB) of mirflowz's nested runs; its jobs declare up to 60 GB (full-genome segemehl index)
    mem_gb: 60
  tesmall:
    # TEsmall's length filter: reads longer than max_length are left out (the minimum is the kit's filtered minimum)
    max_length: 36
    # Mismatches allowed in the genome alignment (0-3) and the most alignments a read may have
    mismatch: 0
    maxaln: 100
    # Class order: a read goes to the first class it overlaps. miRNA first, as UNITAS and miRge3 rank miRNAs; TEsmall's own
    # default puts structural_RNA first, so miRBase miRNAs inside snoRNA or other structural genes lose their reads
    order: miRNA,hairpin,structural_RNA,exon,TE,intron,piRNA_cluster
  tinyrna:
    # Mismatches allowed in the end-to-end Bowtie 1 genome alignment (0-3; tinyRNA's default 0)
    mismatch: 0
    # Counting rules (Features Sheet), on mature miRNAs: a read counts when its 5' end is at one of these offsets from
    # the annotated 5' end (positive: towards the 3' end), it ends at most three_prime_extension nt beyond the annotated
    # 3' end, and has this strand relative to the miRNA and length (nt: a length, range or list)
    five_prime_offsets: -1,0,1
    three_prime_extension: 4
    strand: sense
    length: 16-28
    # Divide a sequence's reads between its genomic loci and between the features selected at a locus (tiny-count's
    # defaults); false gives each locus or feature the full count
    normalize_by_genomic_hits: true
    normalize_by_feature_hits: true

align:
  genome:
    aligner: star
  star:
    args: '--outSAMtype BAM SortedByCoordinate --genomeLoad LoadAndKeep --outMultimapperOrder Random --outSAMstrandField intronMotif --outSAMunmapped Within --outSAMattrIHstart 0 --outFilterMismatchNoverLmax 0.05 --outFilterMatchNmin 15 --outFilterScoreMinOverLread 0  --outFilterMatchNminOverLread 0 --alignIntronMax 1 --limitBAMsortRAM 20000000000 --outFilterMultimapNmax 10 --outFilterMultimapScoreRange 0 --alignEndsType EndToEnd '
    guided_index: false

filter:
  spikein:
    # Set per project. Comma-separated spike-in sets, e.g. 'ERCC92,smallrna_calibrators', or paths to the project's own
    # FASTA; null for none, and then no spike-in step runs
    ref: null
    # Used only with sets listed: bowtie (count, then remove before quantification) or native (the quantifiers estimate them)
    quantifier: bowtie
  ribosomal:
    filter: false
    quantifier: skip
    ref: ncbi
  contaminants:
    filter: false
    quantifier: skip
    ref: univec_core
