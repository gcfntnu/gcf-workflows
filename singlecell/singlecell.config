workflow: singlecell

quant:
  use_velo: true
  doublet_detection:
    method: default
  demultiplex:
    method: skip
    donor_dir: null
    n_individuals: -1
  aggregate:
    skip: false
    method: default
    norm: 'none'
    groupby: all_samples
  starsolo:
    preprocessor: ''
    trimmer: ''
    output_bam: false
    limit_bam_sort_ram: 64000000000
    bam_tags:
      - NH
      - HI
      - nM
      - AS
      - CR
      - UR
      - CB
      - UB
      - GX
      - GN
    feature_count: 'GeneFull_Ex50pAS'
    multi_mappers: 'Unique'
    10x_starsolo:
      umi_dedup: '1MM_CR'
      umi_filtering: 'MultiGeneUMI_CR'
    parsebio_starsolo:
      umi_dedup: '1MM_All'
      umi_filtering: '-'
  cellranger:
    mkgtf:
      gene_biotype:
        - protein_coding
        - lincRNA
    reanalyze:
      skip: true
  cellbender:
    enabled: false
    use_outputs: false
    methods: ['splitpipe', 'cellranger', 'parsebio_starsolo']
    sublibs: []
    extra_args: ''
  cellbender_call:
    subset: ''
    threshold: 0.5
    method: 'AND'
    allow_fuzzy: false

celltype_annotation:
  method: ''
  orthologs: ''

qc:
  fit:
    exclude_doublets: true
    min_cells: 100
    doublet_column: doublet_call
    singlet_value: singlet
  metrics:
    total_counts:
      scale: log1p
      mad_low: 3
      mad_high: 5
    n_genes_by_counts:
      scale: log1p
      mad_low: 3
      mad_high: 5
    mt_fraction:
      scale: raw
      mad_high: 3


preprocessing:
  enabled: true

  filtering:
    cells:
      qc_column: autoqc_pass
      qc_pass_value: true
      exclude_doublets: true
      doublet_column: doublet_call
      singlet_value: singlet

    genes:
      min_cells: 3

  metadata:
    keep:
      - sample_id
      - library_id
      - Sample_Group

    annotation_columns: []

    technical_columns:
      - library_id

    biological_columns:
      - Sample_Group

  expression:
    counts_source: X

    normalization:
      target_sum: 10000
      log1p: true

  representation:
    hvg:
      flavor: seurat_v3
      n_top_genes: 4000
      batch_key: null

    scale: false

    pca:
      n_comps: 100
      random_state: 0

  integration:
    enabled: false
    method: null

    harmony:
      batch_key: library_id

    scvi:
      batch_key: library_id
      n_latent: 50
      max_epochs: 400
      categorical_covariates: []
      continuous_covariates: []

  graph:
    dimensions:
      - 30
      - 50
      - 75
      - 100

    n_neighbors:
      - 15
      - 30
      - 50
      - 75

    metric: euclidean

  clustering:
    resolutions:
      - 0.25
      - 0.5
      - 0.75
      - 1.0
      - 1.5
      - 2.0

    random_states:
      - 0
      - 1
      - 2

  rare_cells:
    enabled: false

  embedding:
    canonical: umap
    evaluate: []

    umap:
      min_dist:
        - 0.1
        - 0.3
        - 0.5

      spread: 1.0

      random_states:
        - 0
        - 1
        - 2

  diagnostics:
    annotation_columns: []
    technical_columns:
      - library_id
    biological_columns:
      - Sample_Group

  execution:
    expression:
      mode: dask
      chunk_size: 20000

    finalize:
      mode: dask
      chunk_size: 20000

    resources:
      plan:
        threads: 4
        mem_mb: 16000

      native_representation:
        threads: 16
        mem_mb: 120000

      integration:
        threads: 16
        mem_mb: 120000

      graph_clustering:
        threads: 16
        mem_mb: 80000

      embedding:
        threads: 16
        mem_mb: 80000

      diagnostics:
        threads: 16
        mem_mb: 64000

      finalize:
        threads: 16
        mem_mb: 160000

pseudobulk:
  replicate_column: Sample_ID
  annotation_column: subclass
  min_cells: 20
  min_counts: 1000
