quant:
  demultiplex:
    cellsnp:
      min_maf: 0.1
      min_count: 20

    vireo:
      min_prob: 0.9
      min_doublet_prob: 0.9
      min_vars: 10
      force_learn_gt: true

    rescue:
      residual_pair:
        enabled: false
        min_depth: 5
        min_shared_variants: 20
        min_vaf_gap: 0.03
        min_gt_gap: 0.03

      fingerprint:
        min_depth: 5

      stable:
        min_pearson: 0.80
        min_shared_variants: 100
        min_margin: 0.20
        min_permutation_gap: 0.20

      targeted_overlap:
        min_pearson: 0.80
        min_shared_variants: 100
        min_support: 2
        min_margin: 0.30

      physical_anchors: {}

    souporcell:
      skip_remap: true

    demuxalot:
      genotype_mode: refine
      doublet_prior: 0.15
      min_prob: 0.9
      vcf_prior_strength: 100.0