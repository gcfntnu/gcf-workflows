
#-*- mode:snakemake -*-
from datetime import datetime

# config
extra_conf_fn = src_gcf('mirbase.config')
if os.path.exists(extra_conf_fn):
    with open(extra_conf_fn) as fh:
        c  = yaml.load(fh, Loader=Loader) or {}
        update_config2(config, c)
        
MIRBASE_RELEASE = str(config['db']['mirbase']['release'])
config['db']['mirbase']['release'] = MIRBASE_RELEASE
ORG = config.get('organism', 'homo_sapiens')
# miRBase serves these releases, uncompressed, under release-specific paths. The /download and
# /download/CURRENT paths follow the current release, and CURRENT returns HTML pages instead of files.
MIRBASE_RELEASES = ('20', '21', '22', '23.1')
if MIRBASE_RELEASE not in MIRBASE_RELEASES:
    raise ValueError('db.mirbase.release: miRBase serves releases {}, got {!r}'.format(', '.join(MIRBASE_RELEASES), MIRBASE_RELEASE))
MIR_ORG = {'homo_sapiens': 'hsa', 'mus_musculus': 'mmu', 'rattus_norvegicus': 'rno'}
if ORG not in MIR_ORG:
    raise ValueError('miRBase references support organism {}, got {!r}'.format(', '.join(MIR_ORG), ORG))

MIRBASE_EXT = join(EXT_DIR, 'mirbase', ORG, 'release-{}'.format(MIRBASE_RELEASE))

URLS = {'hairpin': 'https://www.mirbase.org/download_version_files/{}/hairpin.fa'.format(MIRBASE_RELEASE),
        'mature': 'https://www.mirbase.org/download_version_files/{}/mature.fa'.format(MIRBASE_RELEASE),
        'gff': 'https://www.mirbase.org/download_version_genome_files/{}'.format(MIRBASE_RELEASE)}


rule mirbase_hairpin_fasta:
    params:
        url = URLS['hairpin'],
        script = src_gcf('scripts/mirbase_species_fasta.py'),
        mirbase_org = MIR_ORG[ORG],
        proxy = config.get('proxy', {}).get('wget', ''),
        date = datetime.now().strftime("%d-%m-%Y")
    output:
        fasta = join(MIRBASE_EXT, 'fasta', 'hairpin.fa')
    log:
        join(MIRBASE_EXT, 'logs', 'hairpin.log')
    container:
        'docker://' + config['docker']['default']
    shell:
        """
        wget {params.proxy} {params.url} -O- | python {params.script} --species {params.mirbase_org} - > {output.fasta}
        echo "Mirbase hairpin,{MIRBASE_RELEASE},{params.url},{params.date}" > {log}
        """

rule mirbase_mature_fasta:
    params:
        url = URLS['mature'],
        script = src_gcf('scripts/mirbase_species_fasta.py'),
        mirbase_org = MIR_ORG[ORG],
        proxy = config.get('proxy', {}).get('wget', ''),
        date = datetime.now().strftime("%d-%m-%Y")
    output:
        fasta = join(MIRBASE_EXT, 'fasta', 'mature.fa')
    log:
        join(MIRBASE_EXT, 'logs', 'mature.log')
    container:
        'docker://' + config['docker']['default']
    shell:
        """
        wget {params.proxy} {params.url} -O- | python {params.script} --species {params.mirbase_org} - > {output.fasta}
        echo "Mirbase mature,{MIRBASE_RELEASE},{params.url},{params.date}" > {log}
        """

rule mirbase_gff:        
    params:
        url = URLS['gff'],
        mirbase_org = MIR_ORG[ORG],
        proxy = config.get('proxy', {}).get('wget', ''),
        date = datetime.now().strftime("%d-%m-%Y")
    output:
        join(MIRBASE_EXT, 'anno', 'genes.gff3')
    log:
       join(MIRBASE_EXT, 'logs', 'gff.log')
    container:
        'docker://' + config['docker']['default']
    shell:
        """
        wget {params.proxy} -O - {params.url}/{params.mirbase_org}.gff3 > {output}
        head -n 1 {output} | grep -qx '##gff-version 3' || {{ echo "{params.url}/{params.mirbase_org}.gff3 is not GFF3" >&2; exit 1; }}
        grep -q '^# microRNAs: *miRBase v{MIRBASE_RELEASE}$' {output} || {{ echo "{params.url}/{params.mirbase_org}.gff3 is not miRBase release {MIRBASE_RELEASE}" >&2; exit 1; }}
        echo "Mirbase gff,{MIRBASE_RELEASE},{params.url},{params.date}" > {log}
        """

rule mirbase_genes:
    input:
        rules.mirbase_gff.output
    params:
        script = src_gcf('scripts/mirbase_gff2genes.py')
    output:
        join(MIRBASE_EXT, 'anno', 'genes.tsv')
    container:
        'docker://' + config['docker']['default']
    shell:
        'python {params.script} {input} > {output}'
        
rule mirbase_db_all:
    input:
        join(MIRBASE_EXT, 'fasta', 'hairpin.fa'),
        join(MIRBASE_EXT, 'fasta', 'mature.fa'),
        join(MIRBASE_EXT, 'anno', 'genes.gff3')
                
