#-*- mode:snakemake -*-
"""Bowtie 2 genome index for the biocore_htseq route (smallrna quant.method: biocore_htseq, #425), on the mirflowz reference
(gcfdb/mirflowz.db).

The biocore_htseq route aligns reads to the genome with Bowtie 2, so it needs a Bowtie 2 index of the genome the other genome
routes use: TEsmall's shared genome FASTA (`tesmall_genome` in gcfdb/tesmall.db, `EXT_DIR/tesmall/<mirflowz
reference>/genome/genome.fa`), indexed into `EXT_DIR/biocore_htseq/<mirflowz reference>/genome/bowtie2/genome.*.bt2`
(BIOCORE_HTSEQ_INDEX). The miRNA annotation is tiny-count's renamed miRBase GFF (gcfdb/tinyrna.db), so the route shares one
genome and miRBase release with mirflowz, TEsmall, tiny-count and the benchmark.

On a reference without TEsmall's genome folder, `tesmall_genome` also builds TEsmall's Bowtie 1 index of it, which
this route does not use; the folder exists once for every route on the reference. Checks of the mirflowz reference
stop the workflow when this route is selected (`BIOCORE_HTSEQ_SELECTED`, set in smallrna/rules/quant.smk).

The pipeline's ncRNA tables (#503) need its annotation: the miRBase GFF3, RNAcentral transcripts and Ensembl genes, all
as feature type `miRNA` (scripts/biocore_htseq_annotation.py). RNAcentral's genome coordinates are downloaded at
TEsmall's release (`TESMALL_RNACENTRAL_RELEASE`, #378) into `sources/rnacentral-<release>/`, and the annotation is
written to `gff-<ID>/rnacentral-<release>/annotation.v<BIOCORE_HTSEQ_ANNOTATION_VERSION>.gff3`, named by the miRNA GFF's
identity (MIRFLOWZ_GFF_ID, #440) and the RNAcentral release; the Ensembl genes come from the reference's GTF. Only for
the organisms and assemblies of `TESMALL_RNACENTRAL_ASSEMBLY` on the Ensembl reference (`BIOCORE_HTSEQ_CLASSES`);
elsewhere, and on a `db.mirflowz.custom` reference, the route counts miRNAs only.
"""

BIOCORE_HTSEQ_REF = join(EXT_DIR, 'biocore_htseq', os.path.relpath(MIRFLOWZ_REF, join(EXT_DIR, 'mirflowz')))
BIOCORE_HTSEQ_INDEX = join(BIOCORE_HTSEQ_REF, 'genome', 'bowtie2', 'genome')
# Raise when biocore_htseq_annotation.py writes different rows from the same sources.
BIOCORE_HTSEQ_ANNOTATION_VERSION = 1
BIOCORE_HTSEQ_CLASSES = bool(not MIRFLOWZ_CUSTOM and ORG in TESMALL_RNACENTRAL_ASSEMBLY
                             and MIRFLOWZ_ASSEMBLY == TESMALL_RNACENTRAL_ASSEMBLY[ORG])
BIOCORE_HTSEQ_RNACENTRAL = join(BIOCORE_HTSEQ_REF, 'sources', 'rnacentral-{}'.format(TESMALL_RNACENTRAL_RELEASE),
                                '{}.{}.gff3.gz'.format(ORG, TESMALL_RNACENTRAL_ASSEMBLY.get(ORG)))
BIOCORE_HTSEQ_ANNOTATION = join(BIOCORE_HTSEQ_REF, 'gff-{}'.format(MIRFLOWZ_GFF_ID), 'rnacentral-{}'.format(TESMALL_RNACENTRAL_RELEASE),
                                'annotation.v{}.gff3'.format(BIOCORE_HTSEQ_ANNOTATION_VERSION))
# A small index: the supported genomes are shorter than Bowtie 2's 4 Gbp limit for one.
BIOCORE_HTSEQ_INDEX_SUFFIXES = ('1.bt2', '2.bt2', '3.bt2', '4.bt2', 'rev.1.bt2', 'rev.2.bt2')


rule biocore_htseq_bowtie2_index:
    input:
        rules.tesmall_genome.output.fasta
    output:
        expand(BIOCORE_HTSEQ_INDEX + '.{suffix}', suffix=BIOCORE_HTSEQ_INDEX_SUFFIXES)
    params:
        prefix = BIOCORE_HTSEQ_INDEX
    threads:
        8
    resources:
        mem_mb = 16000
    log:
        join(BIOCORE_HTSEQ_REF, 'genome', 'bowtie2', 'bowtie2-build.log')
    benchmark:
        join(BIOCORE_HTSEQ_REF, 'benchmarks', 'biocore_htseq_bowtie2_index.tsv')
    container:
        'docker://' + config['docker']['biocore_htseq_bowtie2']
    shell:
        'bowtie2-build --threads {threads} {input:q} {params.prefix:q} > {log:q} 2>&1'


if BIOCORE_HTSEQ_CLASSES:
    rule biocore_htseq_rnacentral:
        output:
            BIOCORE_HTSEQ_RNACENTRAL
        params:
            url = 'https://ftp.ebi.ac.uk/pub/databases/RNAcentral/releases/{}/genome_coordinates/gff3/{}.{}.gff3.gz'.format(
                TESMALL_RNACENTRAL_RELEASE, ORG, TESMALL_RNACENTRAL_ASSEMBLY.get(ORG)),
            proxy = config.get('proxy', {}).get('wget', '')
        log:
            join(BIOCORE_HTSEQ_REF, 'sources', 'rnacentral-{}'.format(TESMALL_RNACENTRAL_RELEASE), 'rnacentral.log')
        shell:
            'wget {params.proxy} -q -O {output}.part {params.url} && gzip -t {output}.part && mv {output}.part {output} && '
            'echo "RNAcentral,{TESMALL_RNACENTRAL_RELEASE},{params.url},`date -I`" > {log}'


    rule biocore_htseq_annotation:
        input:
            mirna_gff = rules.tinyrna_gff.output.gff,
            rnacentral = rules.biocore_htseq_rnacentral.output,
            gtf = lambda wildcards: mirflowz_sources()['gtf'],
            fai = rules.tesmall_genome.output.fai
        output:
            BIOCORE_HTSEQ_ANNOTATION
        params:
            script = src_gcf('scripts/biocore_htseq_annotation.py')
        resources:
            mem_mb = 2000
        benchmark:
            join(os.path.dirname(BIOCORE_HTSEQ_ANNOTATION), 'benchmarks', 'biocore_htseq_annotation.tsv')
        container:
            'docker://' + config['docker']['default']
        shell:
            'python {params.script:q} --mirna-gff {input.mirna_gff:q} --rnacentral {input.rnacentral:q} '
            '--gtf {input.gtf:q} --fai {input.fai:q} > {output:q}.part && mv {output:q}.part {output:q}'
