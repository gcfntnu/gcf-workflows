#-*- mode: snakemake -*-
"""Select the genome and annotation directory shared by quantification and reporting."""

REF_DIR = config.get('ref_dir')
requested_provider = config['db']['reference_db']
ref = requested_provider
TENX_ASSEMBLIES = {
    'homo_sapiens': 'GRCh38',
    'mus_musculus': 'GRCm38',
    'homo_sapiens__mus_musculus': 'GRCh38_GRCm38',
}

if not REF_DIR and ref == '10xgenomics' and ORG not in TENX_ASSEMBLIES:
    if not config['db']['ensembl'].get('assembly'):
        raise ValueError(f"No 10xgenomics prebuilt or matching Ensembl assembly for {ORG}. "
                         "Select a project ref_dir or configure a custom reference.")
    ref = config['db']['reference_db'] = 'ensembl'

USE_10X_PREBUILT = not REF_DIR and ref == '10xgenomics'
if not REF_DIR and ref in ('refseq', 'custom_reference', '10xgenomics', 'gencode'):
    include: '{}.db'.format(ref)

DB_CONF = config['db'].setdefault(ref, {})
source = 'ref_dir' if REF_DIR else ref
source_release = DB_CONF.get('release')
if not REF_DIR:
    if ref == 'ensembl':
        REF_DIR = ENSEMBL_DIR
        if ENS_DIVISION and ENS_DIVISION != 'vertebrates':
            source, source_release = 'ensemblgenomes', ENSEMBL_ARCHIVE_RELEASE
    else:
        release_dir = f'release-{source_release}' if source_release is not None else ''
        REF_DIR = join(EXT_DIR, ref, release_dir, ORG, str(DB_CONF.get('assembly') or ''))

include: 'scripts/reference_identity.py'

frozen_generation = frozen_cellranger_generation(REF_DIR) if config.get('ref_dir') else None
build_10x_reference = config['workflow'] == 'singlecell' and (config.get('libprepkit') or '').startswith('10X Genomics') and not USE_10X_PREBUILT
selected_source = str(frozen_generation / 'gcf-source') if frozen_generation else REF_DIR
REFERENCE_SOURCE_DIGEST = REFERENCE_SOURCE_CHECKSUMS = None
if frozen_generation:
    REFERENCE_SOURCE_CHECKSUMS = verify_frozen_reference_inputs(frozen_generation)
elif build_10x_reference and (config.get('ref_dir') or all(os.path.isfile(join(selected_source, member)) for member in CELLRANGER_SOURCES)):
    REFERENCE_SOURCE_CHECKSUMS = reference_checksums(selected_source)
if REFERENCE_SOURCE_CHECKSUMS is not None:
    REFERENCE_SOURCE_DIGEST = reference_digest(REFERENCE_SOURCE_CHECKSUMS)

if frozen_generation:
    # Published generations are immutable. All genome consumers use a workdir copy,
    # including quantifiers that derive indexes or annotation beside their input FASTA.
    source_key = hashlib.sha256(os.fsencode(selected_source)).hexdigest()
    REF_DIR = join(QUANT_INTERIM, 'reference', 'imported', source_key, REFERENCE_SOURCE_DIGEST)

    rule stage_frozen_reference:
        input:
            fasta = join(selected_source, 'fasta', 'genome.fa'),
            gtf = join(selected_source, 'anno', 'genes.gtf')
        output:
            fasta = join(REF_DIR, 'fasta', 'genome.fa'),
            gtf = join(REF_DIR, 'anno', 'genes.gtf')
        params:
            script = join(GCFDB_DIR, 'scripts', 'stage_project_annotation.sh'),
            root = REF_DIR,
            checksums = REFERENCE_SOURCE_CHECKSUMS
        container:
            'docker://' + config['docker']['default']
        shell:
            'bash {params.script:q} {input.fasta:q} {input.gtf:q} {params.root:q} {params.checksums:q}'

config['base_ref_dir'] = REF_DIR
reference_message = "Reference for {}: source={} release={} assembly={} directory={}".format(
    ORG, source, source_release or 'unspecified', DB_CONF.get('assembly') or 'unspecified', REF_DIR)
if frozen_generation:
    reference_message += f' frozen_source={selected_source}'
if source == 'ensemblgenomes':
    reference_message += f' division={ENS_DIVISION}'
if ref != requested_provider:
    logger.warning(f"No {requested_provider} prebuilt for {ORG}. {reference_message}")
else:
    logger.info(reference_message)


def get_genome(*args, **kw):
    return join(REF_DIR, 'fasta', 'genome.fa')


def get_gtf(*args, **kw):
    return join(REF_DIR, 'anno', 'genes.gtf')

if frozen_generation:
    # Published files are inputs. Every job must own its output directory entries.
    workdir_reference_links = set()

    def check_reference_outputs(wildcards, rulename):
        outputs, _ = workflow.get_rule(rulename).expand_output(wildcards)
        for output in outputs:
            path = Path(output)
            entry = path.parent.resolve() / path.name
            # The publisher atomically replaces its own receipt symlink in the workdir.
            # Other outputs must also be safe when reached through a leaf symlink.
            destinations = [entry] if (rulename, entry) in workdir_reference_links else [entry, entry.resolve()]
            for target in destinations:
                if target.is_relative_to(frozen_generation):
                    relative = target.relative_to(frozen_generation)
                    if relative.parts[:1] == ('gcf-source',):
                        relative = relative.relative_to('gcf-source')
                    raise ValueError(f'Cannot write inside a published Cell Ranger generation: {output}. Request {Path(REF_DIR) / relative} instead.')
        return 0

    # Snakemake evaluates resource functions for selected jobs before preparing outputs,
    # in both execution and dry runs. Cover rules included before and after this reader.
    workflow.resource_settings.default_resources.parsed['gcf_reference_writes'] = check_reference_outputs
    for registered_rule in workflow.rules:
        registered_rule.resources['gcf_reference_writes'] = check_reference_outputs
