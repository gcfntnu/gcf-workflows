#-*- mode:snakemake -*-
"""miRge3 libraries (https://github.com/mhalushka/miRge3.0).

`db.mirge3.release` selects the library:

- A dated release, e.g. `09-11-2026`: libraries built from public sources by gcfntnu/gcf-docker `mirge3-build`,
  downloaded from `<winecellar.url>/mirge3/<release>/miRge3_lib_<organism>.tar.gz` into
  `EXT_DIR/mirge3/<release>/<org>/` (scripts/mirge3_library.py). The archive must match the release's `SHA256SUMS`
  before it is unpacked; the files miRge3 opens and the provenance files (`gcf_mirna_db.tsv`, `gcf_manifest.tsv`,
  `gcf_sources.tsv`) must be present. The library's own spike-in index is removed: spike-ins are a library prep
  choice, and smallrna builds the spike-in index from `filter.spikein.ref` in each project's own library (links to
  this one), so the shared library is not changed after installation. The result is recorded in
  `EXT_DIR/mirge3/<release>/verify/miRge3_lib_<organism>.tsv`.
- `sourceforge`: the unversioned miRge3 SourceForge library, kept for retained analyses at its old place,
  `EXT_DIR/mirge3/<organism>/<org>/`, so existing copies are neither moved nor downloaded again. It has no checksums
  or provenance records.

Libraries exist for human, mouse and rat. `<org>` is miRge3's `--organism-name`.
"""
MIRGE3_ORGS = {'homo_sapiens': 'human', 'mus_musculus': 'mouse', 'rattus_norvegicus': 'rat'}
if config['organism'] not in MIRGE3_ORGS:
    raise ValueError('miRge3 libraries exist for {}, got {!r}'.format(', '.join(MIRGE3_ORGS), config['organism']))
MIRGE_ORG = MIRGE3_ORGS[config['organism']]
MIRGE3_RELEASE = str(config['db'].get('mirge3', {}).get('release') or '')
if not MIRGE3_RELEASE:
    raise ValueError('db.mirge3.release is not set: use a dated release, e.g. 09-11-2026, or sourceforge')
# Root passed to miRge3 as --libraries-path; the library itself is <root>/<org>/.
MIRGE3_LIB = join(EXT_DIR, 'mirge3', config['organism'] if MIRGE3_RELEASE == 'sourceforge' else MIRGE3_RELEASE)
MIRGE3_EXT = join(MIRGE3_LIB, MIRGE_ORG)

if MIRGE3_RELEASE == 'sourceforge':
    rule mirge3_prebuild:
        params:
            url = 'https://sourceforge.net/projects/mirge3/files/miRge3_Lib/{}.tar.gz/download'.format(MIRGE_ORG),
            proxy = config.get('proxy', {}).get('wget', ''),
            date = datetime.now().strftime("%d-%m-%Y"),
        output:
            join(MIRGE3_EXT, 'index.Libs', '{}_snorna.3.ebwt'.format(MIRGE_ORG))
        log:
            join(MIRGE3_EXT, 'logs', 'mirge3_reference.log')
        shell:
            """
            wget {params.proxy} -qO- {params.url} | tar xvz --strip-components 1 -C {MIRGE3_EXT}
            echo "mirge3,NA,{params.url},{params.date}" > {log}
            """
    MIRGE3_LIBRARY = rules.mirge3_prebuild.output[0]
    MIRGE3_VERIFICATION = []
else:
    rule mirge3_library:
        output:
            join(MIRGE3_LIB, 'verify', 'miRge3_lib_{}.tsv'.format(config['organism']))
        params:
            script = src_gcf('scripts/mirge3_library.py'),
            url = join(config.get('winecellar', {}).get('url', ''), 'mirge3', MIRGE3_RELEASE),
            species = config['organism'],
            org = MIRGE_ORG,
            release = MIRGE3_RELEASE,
            root = MIRGE3_LIB
        shell:
            'python {params.script} --release-url {params.url} --release {params.release} --species {params.species} '
            '--organism-name {params.org} --libraries-path {params.root} --output {output}'
    MIRGE3_LIBRARY = rules.mirge3_library.output[0]
    MIRGE3_VERIFICATION = rules.mirge3_library.output[0]
