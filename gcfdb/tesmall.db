#-*- mode:snakemake -*-
"""TEsmall database (smallrna quant.method: tesmall, #374).

TEsmall's own prebuilt databases are replaced by one built from release-pinned public sources, on the genome of the
mirflowz reference (gcfdb/mirflowz.db: the Ensembl release fixed per organism on the assembly of the miRBase GFF, or
the manual `db.mirflowz.custom` reference), so TEsmall, mirflowz and the benchmark use the same genome, annotation and
miRBase release. The sources:

- genome and GTF, miRBase GFF and chromosome map: those of the mirflowz reference;
- GtRNAdb tRNA genes (`TESMALL_GTRNADB`, on the organism's assembly; their sequences are checked against the genome);
- UCSC RepeatMasker (`TESMALL_RMSK`);
- the NCBI rDNA unit (`TESMALL_RDNA`), with the Ensembl rRNA genes;
- piRNA clusters from the configured UNITAS reference dump (`piRclDB`, piRNAclusterDB), placed on the genome by
  anchor matches (scripts/tesmall_db.py).

Layout under `EXT_DIR/tesmall/<mirflowz reference>/` (TESMALL_REF):

- `sources/` and `genome/` (the genome FASTA and its Bowtie 1 index, built from the genome alone), shared by every
  database on this reference;
- `gff-<ID>/unitas-<db.unitas release>/` (TESMALL_DUMP_REF), one per miRNA GFF (its identity, MIRFLOWZ_GFF_ID,
  #440) and UNITAS reference dump, as the miRNA annotation and the piRNA clusters come from them: the database
  TEsmall reads with `--dbfolder TESMALL_DB -g TESMALL_NAME`, `db/genomes/TESMALL_NAME/` (`annotation/`, `sequence/`
  with relative links to the shared genome files, `sequence/bowtie_index/`), and `tesmall_reference.tsv` recording
  sources, checksums and counts.

TESMALL_NAME is not one of TEsmall's built-in genome names, so a database that fails TEsmall's own checks stops the
run instead of starting a download.

With `quant.tesmall.structural_rnacentral` (#378), TEsmall reads a database derived from that one,
`gff-<ID>/unitas-<release>-rnacentral-<RNAcentral release>/` (TESMALL_RNACENTRAL_REF): its structural RNA class adds
RNAcentral's snoRNA, scaRNA, Y RNA, vault RNA and 7SK entries (scripts/tesmall_rnacentral.py), and every other file is
a relative link to the base database, which is built and used as before. The RNAcentral source and its log are kept in
that folder too, so the setting writes nothing in the folders the base database shares. Human and mouse only: RNAcentral
has no coordinates on TEsmall's rat assembly (Rnor_6.0).
"""
import shlex

TESMALL_ORGANISMS = ('homo_sapiens', 'mus_musculus', 'rattus_norvegicus')
TESMALL_GTRNADB = {'homo_sapiens': ('Hsapi38', 'hg38'), 'mus_musculus': ('Mmusc39', 'mm39'), 'rattus_norvegicus': ('Rnorv6', 'rn6')}
TESMALL_RMSK = {'homo_sapiens': 'hg38', 'mus_musculus': 'mm39', 'rattus_norvegicus': 'rn6'}
TESMALL_ASSEMBLY = {'homo_sapiens': 'GRCh38', 'mus_musculus': 'GRCm39', 'rattus_norvegicus': 'Rnor_6.0'}
# NCBI nucleotide records of the rDNA unit (45S); the 5S and mitochondrial rRNAs come from the Ensembl GTF.
TESMALL_RDNA = {'homo_sapiens': 'U13369.1', 'mus_musculus': 'BK000964.3', 'rattus_norvegicus': 'NR_046239.1'}
TESMALL_BUILTIN = ('hg19', 'hg38', 'mm10', 'mm39', 'dm6', 'GRCz11', 'T2Tv2')
TESMALL_NAME = 'gcf'
TESMALL_INDEX = ('1.ebwt', '2.ebwt', '3.ebwt', '4.ebwt', 'rev.1.ebwt', 'rev.2.ebwt')


def tesmall_fail(message):
    if TESMALL_SELECTED:
        raise ValueError(message)


TESMALL_REF = join(EXT_DIR, 'tesmall', os.path.relpath(MIRFLOWZ_REF, join(EXT_DIR, 'mirflowz')))
TESMALL_GENOME = join(TESMALL_REF, 'genome')
TESMALL_DUMP_REF = join(TESMALL_REF, 'gff-{}'.format(MIRFLOWZ_GFF_ID), 'unitas-{}'.format(UNITAS_RELEASE))
TESMALL_DB = join(TESMALL_DUMP_REF, 'db')
TESMALL_GENOME_DIR = join(TESMALL_DB, 'genomes', TESMALL_NAME)
if ORG not in TESMALL_ORGANISMS:
    tesmall_fail('TEsmall databases support organism {}, got {!r}'.format(', '.join(TESMALL_ORGANISMS), ORG))
elif not MIRFLOWZ_CUSTOM and MIRFLOWZ_ASSEMBLY != TESMALL_ASSEMBLY[ORG]:
    tesmall_fail('TEsmall: the GtRNAdb and RepeatMasker sources are on {}, but the reference genome is on {}'.format(
        TESMALL_ASSEMBLY[ORG], MIRFLOWZ_ASSEMBLY))
# TEsmall removes the string "genomes" from its --dbfolder path, so such a path would point elsewhere. tesmall_quant
# passes the resolved path (symbolic links followed), so that is the one checked.
if 'genomes' in os.path.realpath(TESMALL_DB):
    tesmall_fail('TEsmall: the database path {} contains "genomes", which TEsmall strips from it; '
                 'choose an EXT_DIR without it'.format(os.path.realpath(TESMALL_DB)))
assert TESMALL_NAME not in TESMALL_BUILTIN

# RNAcentral entries in the structural RNA class (#378): a database of its own, so a project never mixes the two builds
TESMALL_RNACENTRAL = ((config.get('quant') or {}).get('tesmall') or {}).get('structural_rnacentral', False)
if not isinstance(TESMALL_RNACENTRAL, bool):
    raise ValueError('quant.tesmall.structural_rnacentral must be true or false, got {!r}'.format(TESMALL_RNACENTRAL))
TESMALL_RNACENTRAL_RELEASE = '28.0'
TESMALL_RNACENTRAL_ASSEMBLY = {'homo_sapiens': 'GRCh38', 'mus_musculus': 'GRCm39'}
TESMALL_RNACENTRAL_REF = '{}-rnacentral-{}'.format(TESMALL_DUMP_REF, TESMALL_RNACENTRAL_RELEASE)
TESMALL_RNACENTRAL_DB = join(TESMALL_RNACENTRAL_REF, 'db')
TESMALL_RNACENTRAL_GENOME_DIR = join(TESMALL_RNACENTRAL_DB, 'genomes', TESMALL_NAME)
if TESMALL_RNACENTRAL:
    if ORG not in TESMALL_RNACENTRAL_ASSEMBLY or MIRFLOWZ_CUSTOM:
        tesmall_fail('quant.tesmall.structural_rnacentral: RNAcentral {} has coordinates for {} on {}, not for this reference '
                     '({}{})'.format(TESMALL_RNACENTRAL_RELEASE, ' and '.join(TESMALL_RNACENTRAL_ASSEMBLY),
                                     ' and '.join(TESMALL_RNACENTRAL_ASSEMBLY.values()), ORG, ', custom' if MIRFLOWZ_CUSTOM else ''))
    elif 'genomes' in os.path.realpath(TESMALL_RNACENTRAL_DB):
        tesmall_fail('TEsmall: the database path {} contains "genomes", which TEsmall strips from it; '
                     'choose an EXT_DIR without it'.format(os.path.realpath(TESMALL_RNACENTRAL_DB)))

if ORG in TESMALL_ORGANISMS:
    rule tesmall_gtrnadb:
        output:
            join(TESMALL_REF, 'sources', '{}-tRNAs.tar.gz'.format(TESMALL_GTRNADB[ORG][1]))
        params:
            proxy = config.get('proxy', {}).get('wget', ''),
            url = 'https://gtrnadb.ucsc.edu/GtRNAdb2/genomes/eukaryota/{0}/{1}-tRNAs.tar.gz'.format(*TESMALL_GTRNADB[ORG]),
            version = TESMALL_GTRNADB[ORG][0]
        log:
            join(TESMALL_REF, 'logs', 'gtrnadb.log')
        shell:
            'wget {params.proxy} -q -O {output}.part {params.url} && mv {output}.part {output} && '
            'echo "GtRNAdb,{params.version},{params.url},`date -I`" > {log}'

    rule tesmall_rmsk:
        output:
            join(TESMALL_REF, 'sources', 'rmsk.txt.gz')
        params:
            proxy = config.get('proxy', {}).get('wget', ''),
            url = 'https://hgdownload.soe.ucsc.edu/goldenPath/{}/database/rmsk.txt.gz'.format(TESMALL_RMSK[ORG]),
            version = TESMALL_RMSK[ORG]
        log:
            join(TESMALL_REF, 'logs', 'rmsk.log')
        shell:
            'wget {params.proxy} -q -O {output}.part {params.url} && mv {output}.part {output} && '
            'echo "UCSC RepeatMasker,{params.version},{params.url},`date -I`" > {log}'

    rule tesmall_rdna:
        output:
            join(TESMALL_REF, 'sources', 'rDNA_ncbi.fa')
        params:
            proxy = config.get('proxy', {}).get('wget', ''),
            url = 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id={}&rettype=fasta&retmode=text'.format(TESMALL_RDNA[ORG]),
            accession = TESMALL_RDNA[ORG]
        log:
            join(TESMALL_REF, 'logs', 'rdna.log')
        shell:
            'wget {params.proxy} -q -O {output}.part "{params.url}" && grep -q "^>{params.accession}" {output}.part && '
            'mv {output}.part {output} && echo "NCBI nucleotide,{params.accession},{params.url},`date -I`" > {log}'


# Only the genome: the GTF and the miRNA GFF are inputs of the rules that read them (tesmall_db, tinyrna_gff,
# mirflowz_chr_map), so a new annotation does not rebuild the genome FASTA, its index or the indexes built on it (#433).
rule tesmall_genome:
    input:
        genome = lambda wildcards: mirflowz_sources()['genome']
    output:
        fasta = join(TESMALL_GENOME, 'genome.fa'),
        fai = join(TESMALL_GENOME, 'genome.fa.fai'),
        index = expand(join(TESMALL_GENOME, 'bowtie_index', 'genome.{suffix}'), suffix=TESMALL_INDEX)
    params:
        prefix = join(TESMALL_GENOME, 'bowtie_index', 'genome')
    threads:
        16
    benchmark:
        join(TESMALL_REF, 'benchmarks', 'tesmall_genome.tsv')
    container:
        'docker://' + config['docker']['tesmall']
    shell:
        # Sequence names are cut at the first space, as Bowtie and samtools name them.
        '(gzip -cdf {input.genome} | sed -E "s/^(>[^[:space:]]+).*/\\1/" > {output.fasta}) && samtools faidx {output.fasta} && '
        'bowtie-build -q --threads {threads} {output.fasta} {params.prefix}'


rule tesmall_genome_links:
    """Relative links from a database's genome folder to the shared genome files, where TEsmall looks for them."""
    input:
        rules.tesmall_genome.output
    output:
        fasta = join(TESMALL_GENOME_DIR, 'sequence', 'genome.fa'),
        fai = join(TESMALL_GENOME_DIR, 'sequence', 'genome.fa.fai'),
        index = expand(join(TESMALL_GENOME_DIR, 'sequence', 'bowtie_index', 'genome.{suffix}'), suffix=TESMALL_INDEX)
    params:
        shared = TESMALL_GENOME,
        links = join(TESMALL_GENOME_DIR, 'sequence')
    container:
        'docker://' + config['docker']['default']
    shell:
        'for target in {input}; do link={params.links}/${{target#{params.shared}/}}; '
        'mkdir -p $(dirname $link) && ln -sfr $target $link; done'


rule tesmall_db:
    input:
        unpack(lambda wildcards: mirflowz_sources()),
        fasta = rules.tesmall_genome.output.fasta,
        index = rules.tesmall_genome.output.index,
        links = rules.tesmall_genome_links.output,
        chr_map = rules.mirflowz_chr_map.output,
        trna = join(TESMALL_REF, 'sources', '{}-tRNAs.tar.gz'.format(TESMALL_GTRNADB.get(ORG, ('', ORG))[1])),
        rmsk = join(TESMALL_REF, 'sources', 'rmsk.txt.gz'),
        rdna = join(TESMALL_REF, 'sources', 'rDNA_ncbi.fa'),
        unitas = rules.unitas_db.output.db
    output:
        annotation = expand(join(TESMALL_GENOME_DIR, 'annotation', '{cls}.bed'),
                            cls=('structural_RNA', 'miRNA', 'hairpin', 'exon', 'TE', 'intron', 'piRNA_cluster')),
        sequences = expand(join(TESMALL_GENOME_DIR, 'sequence', '{name}.fa{ext}'), name=('rDNA', 'tDNA'), ext=('', '.fai')),
        index = expand(join(TESMALL_GENOME_DIR, 'sequence', 'bowtie_index', '{name}.{suffix}'), name=('rDNA', 'tDNA'), suffix=TESMALL_INDEX),
        record = join(TESMALL_DUMP_REF, 'tesmall_reference.tsv')
    params:
        script = src_gcf('scripts/tesmall_db.py'),
        seq = join(TESMALL_GENOME_DIR, 'sequence'),
        annotation = join(TESMALL_GENOME_DIR, 'annotation'),
        prefix = join(TESMALL_GENOME, 'bowtie_index', 'genome'),
        sources = ' '.join('--source {}'.format(shlex.quote(s)) for s in (
            'name={}'.format(TESMALL_NAME), 'organism={}'.format(ORG), 'mirbase={}'.format(MIRFLOWZ_MIRBASE),
            'ensembl={}'.format(MIRFLOWZ_RELEASE), 'assembly={}'.format(MIRFLOWZ_ASSEMBLY or 'NA'),
            'gtrnadb={}'.format(TESMALL_GTRNADB.get(ORG, ('NA',))[0]), 'rmsk={}'.format(TESMALL_RMSK.get(ORG, 'NA')),
            'rdna={}'.format(TESMALL_RDNA.get(ORG, 'NA')), 'unitas_dump={}'.format(UNITAS_RELEASE)))
    benchmark:
        join(TESMALL_DUMP_REF, 'benchmarks', 'tesmall_db.tsv')
    container:
        'docker://' + config['docker']['tesmall']
    shell:
        'python {params.script} --genome {input.fasta} --genome-index {params.prefix} --gtf {input.gtf} '
        '--mirna-gff {input.mirna_gff} --chr-map {input.chr_map} --trna-archive {input.trna} --rmsk {input.rmsk} '
        '--rdna {input.rdna} --pirna-clusters {input.unitas}/piRclDB '
        '--annotation {params.annotation} --sequence {params.seq} --record {output.record} {params.sources} && '
        'for n in rDNA tDNA; do samtools faidx {params.seq}/$n.fa && bowtie-build -q {params.seq}/$n.fa {params.seq}/bowtie_index/$n; done'


if ORG in TESMALL_RNACENTRAL_ASSEMBLY:
    rule tesmall_rnacentral:
        output:
            join(TESMALL_RNACENTRAL_REF, 'sources', '{}.{}.gff3.gz'.format(ORG, TESMALL_RNACENTRAL_ASSEMBLY[ORG]))
        params:
            proxy = config.get('proxy', {}).get('wget', ''),
            url = 'https://ftp.ebi.ac.uk/pub/databases/RNAcentral/releases/{}/genome_coordinates/gff3/{}.{}.gff3.gz'.format(
                TESMALL_RNACENTRAL_RELEASE, ORG, TESMALL_RNACENTRAL_ASSEMBLY[ORG]),
            version = TESMALL_RNACENTRAL_RELEASE
        log:
            join(TESMALL_RNACENTRAL_REF, 'logs', 'rnacentral.log')
        shell:
            'wget {params.proxy} -q -O {output}.part {params.url} && gzip -t {output}.part && mv {output}.part {output} && '
            'echo "RNAcentral,{params.version},{params.url},`date -I`" > {log}'

    # Every file of the base database's genome folder, at the same place in the derived one.
    TESMALL_DB_FILES = [os.path.relpath(str(f), TESMALL_GENOME_DIR) for f in list(rules.tesmall_db.output) + list(rules.tesmall_genome_links.output)
                        if str(f).startswith(TESMALL_GENOME_DIR + os.sep)]

    rule tesmall_rnacentral_db:
        """The TEsmall database with RNAcentral's structural entries (#378), derived from the base one."""
        input:
            base = rules.tesmall_db.output,
            links = rules.tesmall_genome_links.output,
            record = rules.tesmall_db.output.record,
            fai = rules.tesmall_genome.output.fai,
            rnacentral = rules.tesmall_rnacentral.output
        output:
            files = [join(TESMALL_RNACENTRAL_GENOME_DIR, f) for f in TESMALL_DB_FILES],
            record = join(TESMALL_RNACENTRAL_REF, 'tesmall_reference.tsv')
        params:
            script = src_gcf('scripts/tesmall_rnacentral.py'),
            base = TESMALL_GENOME_DIR,
            out = TESMALL_RNACENTRAL_GENOME_DIR,
            sources = ' '.join('--source {}'.format(shlex.quote(s)) for s in (
                'rnacentral={}'.format(TESMALL_RNACENTRAL_RELEASE), 'rnacentral_assembly={}'.format(TESMALL_RNACENTRAL_ASSEMBLY[ORG])))
        benchmark:
            join(TESMALL_RNACENTRAL_REF, 'benchmarks', 'tesmall_rnacentral_db.tsv')
        container:
            'docker://' + config['docker']['tesmall']
        shell:
            'python {params.script} --base {params.base} --base-record {input.record} --rnacentral {input.rnacentral} '
            '--genome-fai {input.fai} --out {params.out} --record {output.record} {params.sources}'
