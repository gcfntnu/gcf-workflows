#-*-mode:snakemake-*-
"""
adding a biotype annotation to gtf
[optional]: renaming ERCC probes features to `gene` to get the exons counted in a gene count pipeline
"""
from os.path import abspath

ERCC_DIR = join(EXT_DIR, 'spikein')
# Thermo Fisher's asset server; the old tools.thermofisher.com links return HTTP 403 (#336).
ERCC_URL = 'https://assets.thermofisher.com/TFS-Assets/LSG/manuals/'
# SHA-256 of ERCC92.fa, ERCC92.gtf (inside ERCC92.zip) and cms_095046.txt; the files are dated 2015.
ERCC_CHECKSUMS = abspath(join(GCFDB_DIR, 'checksums', 'ERCC92.sha256'))

rule ercc_files:
    params:
        url = ERCC_URL + 'ERCC92.zip',
        checksums = ERCC_CHECKSUMS,
        proxy = config.get('proxy', {}).get('wget', '')
    output:
        ercc_gtf = temp(join(ERCC_DIR, 'anno', '_ERCC92.gtf')),
        ercc_fasta = join(ERCC_DIR, 'fasta', 'ERCC92.fa')
    log:
       join(ERCC_DIR, 'logs', 'ERCC92.log') 
    shell:
        """
        tmp=$(mktemp -d {output[0]}.XXXXXX)
        trap 'rm -rf "$tmp"' EXIT
        wget {params.proxy} -q -O $tmp/ERCC92.zip {params.url}
        unzip -q $tmp/ERCC92.zip ERCC92.fa ERCC92.gtf -d $tmp
        (cd $tmp && grep -E ' (ERCC92.fa|ERCC92.gtf)$' {params.checksums:q} | sha256sum --check --quiet -)
        mv $tmp/ERCC92.gtf {output.ercc_gtf}
        mv $tmp/ERCC92.fa {output.ercc_fasta}
        echo "ERCC,NA,{params.url},`date -I`" > {log}
        """

rule ercc_gtf:
    input:
        rules.ercc_files.output.ercc_gtf
    output:
        join(ERCC_DIR, 'anno', 'ERCC92.gtf')
    params:
        script = src_gcf('scripts/fix_ercc_gtf.py')
    shell:
        'python {params.script} {input} > {output}'

rule ercc_gtf_gene:
    input:
        rules.ercc_files.output.ercc_gtf
    output:
        join(ERCC_DIR, 'anno', 'ERCC92.gene.gtf')
    params:
        script = src_gcf('scripts/fix_ercc_gtf.py')
    shell:
        'python {params.script} {input} --exon2gene > {output}'    


rule ercc_annotations:
    params:
        url = ERCC_URL + 'cms_095046.txt',
        checksums = ERCC_CHECKSUMS,
        proxy = config.get('proxy', {}).get('wget', '')
    output:
        join(ERCC_DIR, 'anno', 'ERCC92.anno')
    log:
        join(ERCC_DIR, 'logs', 'ERCC_anno.log') 
    shell:
        """
        tmp=$(mktemp -d {output[0]}.XXXXXX)
        trap 'rm -rf "$tmp"' EXIT
        wget {params.proxy} -q -O $tmp/cms_095046.txt {params.url}
        (cd $tmp && grep -E ' cms_095046.txt$' {params.checksums:q} | sha256sum --check --quiet -)
        mv $tmp/cms_095046.txt {output}
        echo "ERCC annotations,NA,{params.url},`date -I`" > {log}
        """
        
rule ercc_db_all:
    input:
        join(ERCC_DIR, 'fasta', 'ERCC92.fa'),
        join(ERCC_DIR, 'anno', 'ERCC92.gtf'),
        join(ERCC_DIR, 'anno', 'ERCC92.gene.gtf'),
        join(ERCC_DIR, 'anno', 'ERCC92.anno'),
        join(ERCC_DIR, 'index', 'ERCC92', 'bowtie', 'ERCC92.1.ebwt'),
        join(ERCC_DIR, 'index', 'ERCC92', 'bowtie2', 'ERCC92.1.bt2')
